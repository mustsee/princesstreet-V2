---
import { Trans } from "astro-i18next/components";
import { t } from "i18next";
import Logo from "~/components/atoms/Logo.astro";
import DateRangePicker from "~/components/widgets/DateRangePicker.astro";
const images = await Astro.glob("~/assets/images/hero-hq/**.jpg");
---

<section>
  <div id="hero-img" class="relative">
    <img
      src={images[0].default.src}
      class="w-full h-full object-cover"
      alt=""
    />
    <div
      class="absolute transform top-1/4 -translate-y-full left-1/2 -translate-x-1/2 md:top-1/2 md:translate-y-1/4 z-10"
    >
      <!-- <div class="flex flex-col items-center px-4 py-2 bg-white">
        <Logo />
      </div> -->
    </div>

    <!-- Booking bar -->
    <div id="hero-booking-bar">
      <form id="date-form">
        <DateRangePicker />
        <button type="submit" id="dates-submit" disabled>
          <span>Book Now</span>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
        </button>
      </form>
    </div>
  </div>
</section>

<div class="max-w-6xl mx-auto px-4 sm:px-6">
  <div class="py-12 md:py-20">
    <div class="flex justify-center mb-8">
      <h2
        class="text-sm sm:text-base bg-white border-y-4 border-yellow-500 dark:bg-slate-900 text-gray-900 dark:text-white px-2 py-1 whitespace-nowrap"
      >
        🧽 clean &nbsp;&sdot;&nbsp; 📍 perfectly located &nbsp;&sdot;&nbsp; 👻
        friendly
      </h2>
    </div>
    <div class="text-center max-w-5xl mx-auto">
      <div class="max-w-3xl mx-auto">
        <p class="text-xl text-gray-600 dark:text-slate-400">
Edinburgh is one of Europe's most captivating cities — and where you stay should match the experience. Housed in a <strong>characterful Victorian tenement building</strong> on the edge of the <strong>historic New Town</strong>, <strong>The Princes Street Hostel</strong> offers the <strong>comfort and cleanliness</strong> you'd expect from a quality city centre hotel, at <strong>a fraction of the price</strong>. Perfectly located <strong>steps from Waverley Station</strong> with the Royal Mile, Princes Street Gardens, and Edinburgh's finest restaurants and bars all within easy walking distance.<br><br>Our <strong>rooms and facilities</strong> are maintained to an <strong>impeccable standard</strong>, our staff are <strong>knowledgeable and genuinely welcoming</strong>, and our location means you spend less time travelling and more time enjoying the city. Whether you're here for a <strong>weekend break</strong> or an <strong>extended stay</strong> — you'll find everything you need, without paying for things you don't.<br><br>A place that feels <strong>safe, comfortable, and friendly</strong> — in the heart of one of the world's greatest cities. <strong>Smart travel starts here.</strong>        </p>
      </div>
    </div>
  </div>

  <style is:global>
    @media (max-width: 767px) {
      #hero-img { height: 500px; }
    }
    @media (min-width: 768px) {
      #hero-img { height: 420px; }
    }
    @media (min-width: 1024px) {
      #hero-img { height: 540px; }
    }
    /* Allow the booking bar panel to overflow the hero section */
    #hero-img { overflow: visible; }

    /* ── Booking bar ── */
    #hero-booking-bar {
      position: absolute;
      bottom: 0;
      left: 50%;
      transform: translate(-50%, 50%);
      z-index: 50;
      width: max-content;
      max-width: calc(100vw - 32px);
    }
    #hero-booking-bar form {
      display: flex;
      align-items: center;
      gap: 10px;
      background: #ffffff;
      border-radius: 60px;
      box-shadow: 0 8px 40px rgba(0,0,0,.18), 0 2px 8px rgba(0,0,0,.08);
      padding: 8px 8px 8px 6px;
    }
    #dates-submit {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      background: #111111;
      color: #ffffff;
      border: none;
      border-radius: 50px;
      padding: 12px 22px;
      font-size: 14px;
      font-weight: 700;
      cursor: pointer;
      white-space: nowrap;
      transition: background .15s, transform .1s, opacity .15s;
      letter-spacing: .03em;
      font-family: 'Inter', system-ui, sans-serif;
    }
    #dates-submit:hover:not(:disabled) {
      background: #f5c518;
      color: #111111;
      transform: scale(1.04);
    }
    #dates-submit:disabled {
      opacity: .4;
      cursor: not-allowed;
    }

    @media (max-width: 680px) {
      #hero-booking-bar {
        bottom: auto;
        top: auto;
        transform: none;
        left: 0;
        width: 100%;
        max-width: 100%;
        position: relative;
        margin-top: -28px;
        padding: 0 16px;
      }
      #hero-booking-bar form {
        border-radius: 16px;
        flex-wrap: wrap;
        justify-content: center;
        padding: 12px 12px 12px 10px;
      }
    }
  </style>
</div>
